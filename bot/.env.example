# Discord bot token (Discord Developer Portal → Bot → Token)
DISCORD_BOT_TOKEN=

# OpenAI API key for mentor responses
OPENAI_API_KEY=

# Optional: override the model (defaults to gpt-4o-mini)
OPENAI_MODEL=

# Optional: channel ID for the daily morning post (meme / vibe-coding news).
# Leave empty to disable.
DAILY_CHANNEL_ID=

# Optional: hour (UTC, 0-23) for the daily post (defaults to 13 = 9am ET)
DAILY_POST_HOUR_UTC=
