# Discord bot token (Discord Developer Portal → Bot → Token)
DISCORD_BOT_TOKEN=

# OpenAI API key for mentor responses
OPENAI_API_KEY=

# Optional: override the model (defaults to gpt-4o-mini)
OPENAI_MODEL=

# Optional: override the channel for the daily news digest
DAILY_NEWS_CHANNEL_ID=

# Optional: override the channel for the daily resource pick
RESOURCES_CHANNEL_ID=
