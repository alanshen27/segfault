generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String
  avatarUrl  String?
  role       String   @default("USER") // USER | MODERATOR | ADMIN
  supabaseId String   @unique
  createdAt  DateTime @default(now())

  questions    Question[]
  submissions  Submission[]
  approvedBy   Approval[]     @relation("ApprovedBy")
  submittedFor Approval[]     @relation("SubmittedFor")
  banks        QuestionBank[]
  posts        ForumPost[]
  comments     ForumComment[]
  votes        ForumVote[]
  commentVotes ForumCommentVote[]
  subreddits   Subreddit[]
  forumTags    ForumTag[]

  projects       Project[]
  builderProfile BuilderProfile?
  buildLogs      BuildLog[]
}

model Question {
  id           String   @id @default(cuid())
  title        String
  content      String
  difficulty   String
  topic        String
  constraints  String?
  sampleInput  String?
  sampleOutput String?
  timeLimit    Int      @default(2000)
  memoryLimit  Int      @default(256)
  approved     Boolean  @default(false)
  createdAt    DateTime @default(now())

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  bankId String?
  bank   QuestionBank? @relation(fields: [bankId], references: [id])

  submissions Submission[]
  approvals   Approval[]
  testCases   QuestionTestCase[]
}

model QuestionTestCase {
  id        String @id @default(cuid())
  input     String @db.Text
  output    String @db.Text
  sortOrder Int    @default(0)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model QuestionBank {
  id          String   @id @default(cuid())
  name        String
  description String
  createdAt   DateTime @default(now())

  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id])

  questions   Question[]
}

model Submission {
  id        String   @id @default(cuid())
  code      String
  language  String
  status    String   @default("PENDING")
  output    String?
  createdAt DateTime @default(now())

  userId     String
  user       User     @relation(fields: [userId], references: [id])

  questionId String
  question   Question @relation(fields: [questionId], references: [id])
}

model Approval {
  id        String   @id @default(cuid())
  status    String   @default("PENDING")
  feedback  String?
  createdAt DateTime @default(now())

  questionId    String
  question      Question @relation(fields: [questionId], references: [id])

  submittedById String
  submittedBy   User     @relation("SubmittedFor", fields: [submittedById], references: [id])

  reviewedById  String?
  reviewedBy    User?    @relation("ApprovedBy", fields: [reviewedById], references: [id])
}

model Subreddit {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String
  iconUrl     String?
  bannerUrl   String?
  color       String   @default("#D35959")
  createdAt   DateTime @default(now())

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  posts ForumPost[]
  tags  ForumTag[]
}

model ForumTag {
  id          String   @id @default(cuid())
  slug        String
  name        String
  color       String   @default("bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400")
  createdAt   DateTime @default(now())

  subredditId String
  subreddit   Subreddit @relation(fields: [subredditId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  posts ForumPost[]

  @@unique([subredditId, slug])
}

model ForumPost {
  id        String   @id @default(cuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  subredditId String?
  subreddit   Subreddit? @relation(fields: [subredditId], references: [id])

  tagId    String?
  forumTag ForumTag? @relation(fields: [tagId], references: [id])

  comments ForumComment[]
  votes    ForumVote[]
  attachments ForumPostAttachment[]
}

model ForumPostAttachment {
  id        String   @id @default(cuid())
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  postId String
  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model ForumComment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  postId String
  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  parentId String?
  parent   ForumComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  ForumComment[] @relation("CommentReplies")
  votes    ForumCommentVote[]
}

model ForumCommentVote {
  id    String @id @default(cuid())
  value Int    // 1 or -1

  userId String
  user   User   @relation(fields: [userId], references: [id])

  commentId String
  comment   ForumComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
}

model ForumVote {
  id    String @id @default(cuid())
  value Int    // 1 or -1

  userId String
  user   User   @relation(fields: [userId], references: [id])

  postId String
  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Project {
  id          String   @id @default(cuid())
  title       String
  tagline     String
  description String?
  githubUrl   String?
  demoUrl     String?
  tags        String[]
  status      String   @default("Idea")
  lookingFor  String[]

  authorId  String
  author    User     @relation(fields: [authorId], references: [id])

  buildLogs BuildLog[]

  createdAt DateTime @default(now())
}

model BuilderProfile {
  id        String   @id @default(cuid())
  bio       String?
  skills    String[]
  interests String[]
  timezone  String?
  school    String?
  openTo    String[]

  githubUrl   String?
  linkedinUrl String?
  websiteUrl  String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BuildLog {
  id      String @id @default(cuid())
  content String

  authorId  String
  author    User   @relation(fields: [authorId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
}
