generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String
  role       String   @default("USER") // USER | MODERATOR | ADMIN
  supabaseId String   @unique
  createdAt  DateTime @default(now())

  questions    Question[]
  submissions  Submission[]
  approvedBy   Approval[]     @relation("ApprovedBy")
  submittedFor Approval[]     @relation("SubmittedFor")
  banks        QuestionBank[]
  posts        ForumPost[]
  comments     ForumComment[]
  votes        ForumVote[]
  subreddits   Subreddit[]
}

model Question {
  id           String   @id @default(cuid())
  title        String
  content      String
  difficulty   String
  topic        String
  constraints  String?
  sampleInput  String?
  sampleOutput String?
  timeLimit    Int      @default(2000)
  memoryLimit  Int      @default(256)
  approved     Boolean  @default(false)
  createdAt    DateTime @default(now())

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  bankId String?
  bank   QuestionBank? @relation(fields: [bankId], references: [id])

  submissions Submission[]
  approvals   Approval[]
}

model QuestionBank {
  id          String   @id @default(cuid())
  name        String
  description String
  createdAt   DateTime @default(now())

  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id])

  questions   Question[]
}

model Submission {
  id        String   @id @default(cuid())
  code      String
  language  String
  status    String   @default("PENDING")
  output    String?
  createdAt DateTime @default(now())

  userId     String
  user       User     @relation(fields: [userId], references: [id])

  questionId String
  question   Question @relation(fields: [questionId], references: [id])
}

model Approval {
  id        String   @id @default(cuid())
  status    String   @default("PENDING")
  feedback  String?
  createdAt DateTime @default(now())

  questionId    String
  question      Question @relation(fields: [questionId], references: [id])

  submittedById String
  submittedBy   User     @relation("SubmittedFor", fields: [submittedById], references: [id])

  reviewedById  String?
  reviewedBy    User?    @relation("ApprovedBy", fields: [reviewedById], references: [id])
}

model Subreddit {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String
  color       String   @default("#D35959")
  createdAt   DateTime @default(now())

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  posts ForumPost[]
}

model ForumPost {
  id        String   @id @default(cuid())
  title     String
  content   String
  tag       String   @default("GENERAL") // GENERAL | QUESTION | EDITORIAL | META
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  subredditId String?
  subreddit   Subreddit? @relation(fields: [subredditId], references: [id])

  comments ForumComment[]
  votes    ForumVote[]
}

model ForumComment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  postId String
  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  parentId String?
  parent   ForumComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  ForumComment[] @relation("CommentReplies")
}

model ForumVote {
  id    String @id @default(cuid())
  value Int    // 1 or -1

  userId String
  user   User   @relation(fields: [userId], references: [id])

  postId String
  post   ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}
